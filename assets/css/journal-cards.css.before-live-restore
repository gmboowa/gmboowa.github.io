/* Journal cards recovered in structure from published GitHub Pages HTML.
   Standalone stylesheet recreated for reusable Jekyll template rendering. */
.journal-thumbnail-panel { width:100%; max-width:150px; margin:0 auto .9rem; text-align:center; }
.journal-thumbnail-link { display:block; color:inherit; text-decoration:none !important; }
.journal-thumbnail-link:hover { text-decoration:none; }
.journal-card { width:100%; overflow:hidden; background:#fff; border-radius:5px; border:1px solid #d7dce1; box-shadow:0 2px 5px rgba(0,0,0,.12); }
.journal-logo-area { height:109px; padding:10px 9px; display:flex; align-items:center; justify-content:center; background:#fff !important; }
.journal-logo { display:block; max-width:100%; max-height:90px; width:auto; height:auto; object-fit:contain; }
.journal-fallback-name { font-size:13px; line-height:1.3; font-weight:700; color:#222; overflow-wrap:anywhere; }
.journal-impact-factor { display:flex; flex-direction:column; align-items:flex-start; justify-content:center; min-height:49px; padding:7px 10px; background:#fff; border-top:1px solid #e6e7e9; color:#222; text-align:left; }
.journal-impact-factor-label { font-size:9px; font-weight:700; text-transform:uppercase; letter-spacing:.025em; line-height:1.25; color:#555; }
.journal-impact-factor-value { font-size:17px; font-weight:700; line-height:1.3; color:#111; }
.journal-thumbnail-name { margin-top:9px; font-size:14px; font-weight:700; line-height:1.3; overflow-wrap:anywhere; }
.journal-thumbnail-name a { color:#21a9c6; }
.journal-thumbnail-name a:hover { text-decoration:underline; }
html[data-theme="dark"] .journal-card, body[data-theme="dark"] .journal-card, .dark .journal-card { background:#fff !important; border-color:#ddd; }
html[data-theme="dark"] .journal-logo-area, body[data-theme="dark"] .journal-logo-area, .dark .journal-logo-area { background:#fff !important; }
html[data-theme="dark"] .journal-impact-factor, body[data-theme="dark"] .journal-impact-factor, .dark .journal-impact-factor { background:#fff !important; }
@media(max-width:575px) { .journal-thumbnail-panel { max-width:150px; margin:0 0 1rem; } }
